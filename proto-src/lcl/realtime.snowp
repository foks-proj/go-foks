@0xf1feae2b2012aad7;

go:import "github.com/foks-proj/go-foks/proto/lib" as lib;

struct RTChannelNameAndTier {
    name @0 : lib.RTChannelName;
    tier @1: lib.RTChannelTier;
}

enum RTChannelSpecifierType {
    None @0;
    ID @1;
    Name @2;
}

variant RTChannelSpecifier switch (t : RTChannelSpecifierType) {
    case ID @1: lib.RTChannelID;
    case Name @2: RTChannelNameAndTier;
    default: void;
}

enum ConfigTeamType {
    None @0;
    Named @1;
    AdHoc @2;
}

variant ConfigTeam switch (t : ConfigTeamType) @0xd087b3b8ff4bc3ea {
    case None: void;
    case Named @1: lib.FQTeamParsed;
    case AdHoc @2: lib.FQAdHocTeamParsed;
}

struct RTConfig {
    team @0 : ConfigTeam;
    appID @1 : lib.RTAppID;
    roles @2 : lib.RolePairOpt;
    channel @3 : RTChannelSpecifier;
}

struct RTChannelMetadataPlaintext {
    id @0 : lib.RTChannelID;
    parentTeam @1 : lib.TeamID;
    appID @2 : lib.RTAppID;
    name @3 : lib.RTChannelName;
    desc @4 : Option(lib.RTChannelDesc);
    roles @5 : lib.RolePair;
    tier @6 : lib.RTChannelTier;
    updatedAt @7 : lib.RTChannelSetVersion;
    unreadable @8 : Bool; // caller can't read this channel (role below read role);
                          // kept for name-collision detection, hidden from the inbox
}

struct RTChannelSetForTeam {
    channels @0 : List(RTChannelMetadataPlaintext);
    vers @1 : lib.RTChannelSetVersion;
    appID @2 : lib.RTAppID;
    team @3 : lib.TeamID;
}

// DB scope for locally-persisted inbox sync state: the inbox is viewer-scoped
// state spanning many parties, so it's keyed by the viewing user plus the app.
struct RTInboxScope {
    fqu @0 : lib.FQUser;
    appID @1 : lib.RTAppID;
}

// Singleton row (per RTInboxScope) holding the inbox sync cursor and the index
// of channels with persisted RTInboxChannel rows. The KV layer can't enumerate
// keys within a scope, hence the explicit index; it's small (channel counts are
// modest in Stage 1a) and is updated atomically with the rows it indexes.
struct RTInboxSyncState {
    vers @0 : lib.RTInboxVersion;         // highest inbox version *applied* locally
    channels @1 : List(lib.RTChannelID);  // channels with a persisted row
}

// One decrypted inbox channel as presented to the CLI / app layer.
struct RTInboxRowView {
    ch @0 : RTChannelMetadataPlaintext;
    inboxVersion @1 : lib.RTInboxVersion; // version at which this channel last bumped
    readThrough @2 : lib.RTMsgSeq;        // viewer's read pointer; 0 = nothing read
    lastSeq @3 : lib.RTMsgSeq;            // last message in channel; 0 = no messages
    lastTime @4 : lib.Time;               // server insert time of last message; 0 if none
    numUnread @5 : Uint;                  // max(lastSeq - readThrough, 0)
    hidden @6 : Bool;
    muted @7 : Bool;
    teamName @8 : lib.NameUtf8;           // via the teamname cache; empty if unresolved
    snippet @9 : Option(Text);            // first line of the last message, decrypted at render;
                                          // nil if the message isn't in the local cache
    lastSender @10 : lib.NameUtf8;        // last message's sender; empty if unresolved
    numPending @11 : Uint;                // viewer's own outbox messages queued here
    numFailed @12 : Uint;                 // viewer's own rejected (Failed) outbox messages here
}

// The viewer's inbox, rendered entirely from local storage.
struct RTInboxView {
    rows @0 : List(RTInboxRowView);       // newest bump first
    vers @1 : lib.RTInboxVersion;         // local sync cursor
    stale @2 : Bool;                      // the pre-render sync failed on transport;
                                          // this is the last locally-applied snapshot
}

// What a SyncInbox pass did.
struct RTInboxSyncSummary {
    vers @0 : lib.RTInboxVersion;         // cursor after the sync
    numChanged @1 : Uint;                 // channel rows applied
}

// A decrypted message as presented to the CLI / app layer.
struct RTMsgView {
    seq @0 : lib.RTMsgSeq;
    msgID @1 : lib.RTMsgID;
    prevID @2 : lib.RTMsgID;
    prevSeq @3 : lib.RTMsgSeq;
    typ @4 : lib.RTMsgType;
    sender @5 : Option(lib.PartyID);   // nil for server-authored
    sentAtTime @6 : lib.Time;          // client-asserted
    insertTime @7 : lib.Time;          // server-asserted
    body @8 : Blob;                    // decrypted plaintext (basic messages)
    senderName @9 : Option(lib.NameUtf8); // resolved by agent via user load; nil if unresolvable
}

// One of the viewer's own undelivered outbox messages, overlaid on the head
// page of a thread view (seq 0 = unassigned). state distinguishes a message
// awaiting delivery from one the server rejected (Failed), which will not be
// retried without an explicit outbox retry.
struct RTPendingMsgView {
    msg @0 : RTMsgView;
    state @1 : RTOutboxState;
}

struct RTThreadView {
    msgs @0 : List(RTMsgView);
    atBeginning @1 : Bool; // page reached the start of the thread; no older messages
    stale @2 : Bool;       // served (partly) from local cache; the server was unreachable
    pending @3 : List(RTPendingMsgView); // viewer's own undelivered messages; head page only
}

protocol RealTime
    argHeader Header
    resHeader Header
    errors lib.Status @0xaaf0cd97 {

    clientRTMakeChannel @0 (
        cfg @0 : RTConfig, /* contains the new channel name (if applicable) */
        desc @1 : lib.RTChannelDesc /* only specify if channel name is specified (above) */
    ) -> lib.RTChannelID;

    clientRTListChannelsForTeam @1 (
        cfg @0 : RTConfig /* contains team and AppID to list channels */
    ) -> RTChannelSetForTeam;

    clientRTSend @2 (
        cfg @0 : RTConfig, /* contains team, AppID and channel to send into */
        body @1 : Blob     /* plaintext message body */
    ) -> lib.RTMsgSeq;     /* server-assigned sequence number */

    clientRTGetThread @3 (
        cfg @0 : RTConfig,      /* contains team, AppID and channel to read */
        num @1 : Uint,          /* max messages in the page; 0 = default */
        before @2 : lib.RTMsgSeq /* page messages older than this seq (exclusive); 0 = most recent */
    ) -> RTThreadView;

    clientRTInboxView @4 (
        appID @0 : lib.RTAppID,
        localOnly @1 : Bool     /* skip the network sync; render from disk only */
    ) -> RTInboxView;

    clientRTOutboxList @5 () -> RTOutboxView;

    clientRTOutboxDrain @6 () -> RTOutboxDrainRes;

    clientRTOutboxRetry @7 (
        msgID @0 : lib.RTMsgID
    ) -> RTOutboxDrainRes;

    clientRTOutboxDiscard @8 (
        msgID @0 : lib.RTMsgID
    );

}

// One outbox entry as presented to the CLI / app layer.
struct RTOutboxRowView {
    msgID @0 : lib.RTMsgID;
    chid @1 : lib.RTChannelID;
    ord @2 : Uint;
    state @3 : RTOutboxState;
    attempts @4 : Uint;
    lastError @5 : Text;
    sendTime @6 : lib.Time;
}

struct RTOutboxView {
    rows @0 : List(RTOutboxRowView); // queue order
}

// What a drain pass did.
struct RTOutboxDrainRes {
    numAcked @0 : Uint;
    numFailed @1 : Uint;   // rows marked Failed by a semantic rejection this pass
    offline @2 : Bool;     // a transport error ended the pass; the rest stays queued
}

// Singleton row (per RTInboxScope-like party scope): read-marks that couldn't
// reach the server, one entry per channel holding the highest locally-read
// seq (intermediate marks are subsumed; the server pointer is monotonic and
// ignores stale marks). Replayed by the outbox drain.
struct RTReadThroughPendingEntry {
    chid @0 : lib.RTChannelID;
    seq @1 : lib.RTMsgSeq;
}

struct RTReadThroughPendingSet {
    entries @0 : List(RTReadThroughPendingEntry);
}

enum RTOutboxState {
    Queued @0;
    Failed @1;
}

// One queued (or failed) outgoing message, stored in the local soft DB keyed
// by its msgID. The message is stored sealed, exactly as it will be sent --
// plaintext never hits the local DB. ord is the per-device FIFO position,
// allocated by RTOutboxIndex.nextOrd.
struct RTOutboxEntry {
    msg @0 : lib.RTMsgCached;
    state @1 : RTOutboxState;
    attempts @2 : Uint;
    lastError @3 : Text;      // last attempt's error; empty until one fails
    ord @4 : Uint;
}

struct RTOutboxIndexEntry {
    msgID @0 : lib.RTMsgID;
    chid @1 : lib.RTChannelID;
    ord @2 : Uint;
    state @3 : RTOutboxState; // mirrors the entry row, for cheap per-channel counts
}

// Singleton row (per party scope) indexing the outbox entries, since the KV
// layer can't enumerate keys within a scope (the RTInboxSyncState pattern).
// Updated atomically with entry-row puts; an index entry whose row is missing
// (a crash between an ack's row delete and this index update) is dropped on
// the next drain.
struct RTOutboxIndex {
    entries @0 : List(RTOutboxIndexEntry);
    nextOrd @1 : Uint;
}

struct RTChannelSetHashInput @0xc6985a2917572061 {
    fqp @0 : lib.FQParty;
    appID @1 : lib.RTAppID;
}

// A hash of the above, to identify a channel for 
typedef RTChannelSetID = lib.StdHash;

struct RTChannelMetadataPlaintextAbbrev {
    name @0 : lib.RTChannelName;
    desc @1 : Option(lib.RTChannelDesc);
}